@model IEnumerable<FPTJobMatch.Models.Job>

@{
    ViewData["Title"] = "Employer Dashboard";
}

<h1>Employer Dashboard</h1>

<h2>Job Statistics by Location</h2>
<table class="table">
    <thead>
        <tr>
            <th>Location</th>
            <th>Number of Jobs</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stat in ViewBag.JobStats)
        {
            <tr>
                <td>@stat.Location</td>
                <td>@stat.Count</td>
            </tr>
        }
    </tbody>
</table>

<h2>Recent Jobs</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Company</th>
            <th>Location</th>
            <th>Posted</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model.Take(5))
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.Company</td>
                <td>@job.Location</td>
                <td>@job.PostedDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
